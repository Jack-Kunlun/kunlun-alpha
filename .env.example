# 昆仑智策 — 应用服务环境变量模板
#
# 仅用于本地开发。复制为 .env 后按需修改；禁止提交真实凭证。
# 基础设施（PostgreSQL/Redis/ClickHouse/MinIO/Grafana）的变量见 infra/docker/.env.example。
#
# 注意：当前应用直接读取进程环境变量（未自动加载 .env 文件）。
# 使用方式任选其一：
#   * 在 shell 中导出后启动：export PORT=3002 && pnpm --filter @kunlun/server dev
#   * 用 dotenv-cli 等工具加载：dotenv -e .env -- pnpm dev

# --- 控制面 API (apps/server/src/env.ts) ---
PORT=3002
NODE_ENV=development

# --- Local administrator authentication ---
# HTTP cookies are permitted only when this explicit flag is paired with a loopback origin.
# Use HTTPS, AUTH_ALLOW_INSECURE_COOKIE=false, and an exact public origin outside local development.
AUTH_POSTGRES_DSN=postgresql://kunlun:kunlun-local-dev@localhost:5432/kunlun?options=-csearch_path%3Dkunlun%2Cpublic
AUTH_PUBLIC_ORIGIN=http://localhost:5173
AUTH_ALLOW_INSECURE_COOKIE=true

# --- PostgreSQL scheduler/migration helpers (local-only example) ---
# Migrations are explicit; API import/boot does not run them automatically.
KUNLUN_POSTGRES_DSN=postgresql://kunlun:kunlun-local-dev@localhost:5432/kunlun
# Opt-in integration tests only; use an isolated schema/database and never production data.
KUNLUN_TEST_POSTGRES_DSN=postgresql://kunlun:kunlun-local-dev@localhost:5432/kunlun
DATA_QUALITY_POSTGRES_DSN=postgresql://kunlun:kunlun-local-dev@localhost:5432/kunlun
EVENT_FEEDBACK_POSTGRES_DSN=postgresql://kunlun:kunlun-local-dev@localhost:5432/kunlun
EVENT_INTELLIGENCE_POSTGRES_DSN=postgresql://kunlun:kunlun-local-dev@localhost:5432/kunlun
INSTRUMENT_INTELLIGENCE_POSTGRES_DSN=postgresql://kunlun:kunlun-local-dev@localhost:5432/kunlun
WATCHLIST_ALERTS_POSTGRES_DSN=postgresql://kunlun:kunlun-local-dev@localhost:5432/kunlun
WATCHLIST_ALERTS_OWNER_REF=local-research-user

# --- ClickHouse persisted emotion/rotation replay (read-only API adapter) ---
EMOTION_CLICKHOUSE_URL=http://localhost:8123
EMOTION_CLICKHOUSE_DATABASE=kunlun
EMOTION_CLICKHOUSE_USER=kunlun
EMOTION_CLICKHOUSE_PASSWORD=kunlun-local-dev
DASHBOARD_EMOTION_ALGORITHM_VERSION=emotion_score_v1
DASHBOARD_CLICKHOUSE_TIMEOUT_MS=5000
INSTRUMENT_INTELLIGENCE_CLICKHOUSE_URL=http://localhost:8123
INSTRUMENT_INTELLIGENCE_CLICKHOUSE_DATABASE=kunlun
INSTRUMENT_INTELLIGENCE_CLICKHOUSE_USER=kunlun
INSTRUMENT_INTELLIGENCE_CLICKHOUSE_PASSWORD=kunlun-local-dev
INSTRUMENT_INTELLIGENCE_CLICKHOUSE_TIMEOUT_MS=5000
# Fail closed by default. Use public only in an explicitly isolated local terminal deployment.
DASHBOARD_TERMINAL_READ_POLICY=deny

# --- Real market Bar synchronization (AKShare default; Tushare optional) ---
# AKShare is token-free. Set MARKET_DATA_PROVIDER=tushare only with an authorized local token.
MARKET_DATA_PROVIDER=akshare
TUSHARE_TOKEN=
# Private instrument-master provider is opt-in through the instrument-master
# compose profile; leave all dedicated credentials empty unless configured in
# an external deployment secret store.
INSTRUMENT_MASTER_RUNTIME_DSN=
INSTRUMENT_MASTER_RUNTIME_DSN_FILE=
INSTRUMENT_MASTER_MIGRATOR_DSN=
INSTRUMENT_MASTER_MIGRATOR_DSN_FILE=
INSTRUMENT_MASTER_MIGRATOR_PASSWORD=
INSTRUMENT_MASTER_RUNTIME_PASSWORD=
# Calendar-quality V5 is opt-in through the calendar-quality compose profile;
# leave dedicated DSNs/passwords empty unless configured in an external secret store.
# Publish accepts only the dedicated administrator DSN. The *_FILE form requires
# an explicitly mounted regular secret file (UID 10001, mode 0400).
CALENDAR_QUALITY_RUNTIME_DSN=
CALENDAR_QUALITY_RUNTIME_DSN_FILE=
CALENDAR_QUALITY_ADMIN_DSN=
CALENDAR_QUALITY_ADMIN_DSN_FILE=
CALENDAR_QUALITY_MIGRATOR_PASSWORD=
CALENDAR_QUALITY_RUNTIME_PASSWORD=
TUSHARE_API_URL=https://api.tushare.pro
MARKET_DATA_SYMBOLS=600519.SH
MARKET_DATA_MINUTE_SYMBOLS=
MARKET_DATA_RAW_ROOT=var/market-raw
MARKET_DATA_RUN_MODE=once
MARKET_DATA_POLL_SECONDS=60
MARKET_DATA_DAILY_LOOKBACK_DAYS=730
MARKET_DATA_MINUTE_INTERVAL=MINUTE_1
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=kunlun
CLICKHOUSE_USER=kunlun
CLICKHOUSE_PASSWORD=kunlun-local-dev
CLICKHOUSE_TIMEOUT_SECONDS=5

# --- Web local reverse proxy (Vite dev/preview) ---
KUNLUN_SERVER_PROXY_TARGET=http://localhost:3002

# --- Python 引擎 (ashare-common ServiceConfig, env_prefix=KUNLUN_) ---
KUNLUN_SERVICE_NAME=kunlun
KUNLUN_LOG_LEVEL=INFO
KUNLUN_HOST=0.0.0.0
KUNLUN_PORT=8080
KUNLUN_SHUTDOWN_TIMEOUT_SECONDS=10.0
