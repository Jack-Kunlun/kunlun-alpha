{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kunlun-alpha.local/schemas/seat-kol/workbench-snapshot.json",
  "title": "SeatKolWorkbenchSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "decisionTime",
    "dataCutoffTime",
    "sourceVersion",
    "mode",
    "dataMeaning",
    "seats",
    "kols",
    "cooccurrences",
    "reviewQueue"
  ],
  "properties": {
    "schemaVersion": { "const": "seat-kol-workbench-v1" },
    "snapshotId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "decisionTime": { "type": "string", "format": "date-time" },
    "dataCutoffTime": { "type": "string", "format": "date-time" },
    "sourceVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "mode": { "enum": ["PERSISTED", "LOCAL_PREVIEW"] },
    "dataMeaning": { "const": "RESEARCH_ONLY_PUBLIC_DATA_NOT_BROKER_EXECUTION" },
    "seats": { "type": "array", "items": { "$ref": "#/$defs/seatProfile" } },
    "kols": { "type": "array", "items": { "$ref": "#/$defs/kolProfile" } },
    "cooccurrences": { "type": "array", "items": { "$ref": "#/$defs/cooccurrence" } },
    "reviewQueue": { "type": "array", "items": { "$ref": "#/$defs/reviewQueueItem" } }
  },
  "$defs": {
    "metric": {
      "title": "SeatKolWorkbenchMetric",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metricName",
        "label",
        "valueBps",
        "sampleCount",
        "confidenceBps",
        "algorithmVersion",
        "policyVersion",
        "dataCutoffTime"
      ],
      "properties": {
        "metricName": {
          "enum": [
            "seat_t_plus_1_return_bps",
            "seat_t_plus_3_return_bps",
            "seat_win_rate_bps",
            "kol_attention_score",
            "consensus_score",
            "claim_score"
          ]
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "valueBps": { "type": ["integer", "null"], "minimum": -10000, "maximum": 10000 },
        "sampleCount": { "type": "integer", "minimum": 0 },
        "confidenceBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "algorithmVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "policyVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "dataCutoffTime": { "type": "string", "format": "date-time" }
      }
    },
    "evidence": {
      "title": "SeatKolWorkbenchEvidence",
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "source", "sourceVersion", "availableTime", "excerpt", "locator"],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "source": { "type": "string", "minLength": 1, "maxLength": 100 },
        "sourceVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
        "availableTime": { "type": "string", "format": "date-time" },
        "excerpt": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "locator": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "timelineEntry": {
      "title": "SeatKolWorkbenchTimelineEntry",
      "type": "object",
      "additionalProperties": false,
      "required": ["entryId", "kind", "occurTime", "availableTime", "title", "evidenceIds"],
      "properties": {
        "entryId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": { "enum": ["PROFILE", "PUBLIC_TRADE", "CLAIM", "REVIEW", "METRIC"] },
        "occurTime": { "type": "string", "format": "date-time" },
        "availableTime": { "type": "string", "format": "date-time" },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "seatProfile": {
      "title": "SeatWorkbenchProfile",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seatId",
        "displayName",
        "seatKind",
        "aliases",
        "metrics",
        "evidence",
        "timeline"
      ],
      "properties": {
        "seatId": { "type": "string", "pattern": "^seat-[0-9a-f]{64}$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "seatKind": { "enum": ["BROKER_BRANCH", "INSTITUTION", "UNKNOWN", "OTHER"] },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 200 },
          "uniqueItems": true
        },
        "metrics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/metric" } },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "timeline": { "type": "array", "items": { "$ref": "#/$defs/timelineEntry" } }
      }
    },
    "claim": {
      "title": "KolWorkbenchClaim",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId",
        "revisionId",
        "statement",
        "instrumentId",
        "direction",
        "reviewStatus",
        "confidenceBps",
        "publishTime",
        "availableTime",
        "deleted",
        "claimMeaning",
        "evidence"
      ],
      "properties": {
        "claimId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "revisionId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "statement": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "instrumentId": { "type": "string", "pattern": "^[0-9]{6}\\.(SH|SZ|BJ)$" },
        "direction": { "enum": ["BULLISH", "BEARISH", "NEUTRAL"] },
        "reviewStatus": { "enum": ["UNREVIEWED", "IN_REVIEW", "APPROVED", "REJECTED"] },
        "confidenceBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "publishTime": { "type": "string", "format": "date-time" },
        "availableTime": { "type": "string", "format": "date-time" },
        "deleted": { "type": "boolean" },
        "claimMeaning": { "const": "PUBLIC_WORDING_CLAIM_NOT_BROKER_TRADE" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "kolProfile": {
      "title": "KolWorkbenchProfile",
      "type": "object",
      "additionalProperties": false,
      "required": ["kolId", "displayName", "metrics", "claims", "evidence", "timeline"],
      "properties": {
        "kolId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "metrics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/metric" } },
        "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "timeline": { "type": "array", "items": { "$ref": "#/$defs/timelineEntry" } }
      }
    },
    "cooccurrence": {
      "title": "SeatKolCooccurrence",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cooccurrenceId",
        "leftEntityType",
        "leftEntityId",
        "leftDisplayName",
        "rightEntityType",
        "rightEntityId",
        "rightDisplayName",
        "scoreBps",
        "sampleCount",
        "algorithmVersion",
        "policyVersion",
        "dataCutoffTime",
        "evidenceIds"
      ],
      "properties": {
        "cooccurrenceId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "leftEntityType": { "enum": ["SEAT", "KOL"] },
        "leftEntityId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "leftDisplayName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "rightEntityType": { "enum": ["SEAT", "KOL"] },
        "rightEntityId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "rightDisplayName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "scoreBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "sampleCount": { "type": "integer", "minimum": 0 },
        "algorithmVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "policyVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "dataCutoffTime": { "type": "string", "format": "date-time" },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "reviewQueueItem": {
      "title": "KolReviewQueueItem",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "revisionId",
        "statement",
        "instrumentId",
        "confidenceBps",
        "reviewStatus",
        "availableTime",
        "reviewMeaning",
        "evidence"
      ],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "revisionId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "statement": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "instrumentId": { "type": "string", "pattern": "^[0-9]{6}\\.(SH|SZ|BJ)$" },
        "confidenceBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "reviewStatus": { "enum": ["UNREVIEWED", "IN_REVIEW", "APPROVED", "REJECTED"] },
        "availableTime": { "type": "string", "format": "date-time" },
        "reviewMeaning": { "const": "PUBLIC_WORDING_REVIEW_NOT_FACT_OR_EXECUTION" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      }
    }
  }
}
