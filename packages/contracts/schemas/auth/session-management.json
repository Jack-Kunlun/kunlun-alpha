{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kunlun-alpha/schemas/auth/session-management.json",
  "title": "AuthSessionListResponse",
  "description": "Active local research-terminal sessions represented by non-credential references",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "auth-session-list-v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sessions": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/definitions/AuthSessionSummary" }
    }
  },
  "required": ["schemaVersion", "generatedAt", "sessions"],
  "additionalProperties": false,
  "definitions": {
    "AuthSessionSummary": {
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "current": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastSeenAt": { "type": "string", "format": "date-time" },
        "idleExpiresAt": { "type": "string", "format": "date-time" },
        "absoluteExpiresAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "sessionId",
        "current",
        "createdAt",
        "lastSeenAt",
        "idleExpiresAt",
        "absoluteExpiresAt"
      ],
      "additionalProperties": false
    },
    "AuthPasswordChangeResponse": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": "auth-password-change-v1" },
        "changedAt": { "type": "string", "format": "date-time" },
        "revokedOtherSessions": { "type": "integer", "minimum": 0 }
      },
      "required": ["schemaVersion", "changedAt", "revokedOtherSessions"],
      "additionalProperties": false
    },
    "AuthSessionRevocationResponse": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": "auth-session-revocation-v1" },
        "revoked": { "const": true }
      },
      "required": ["schemaVersion", "revoked"],
      "additionalProperties": false
    }
  }
}
