{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kunlun-alpha/schemas/auth/session.json",
  "title": "AuthSessionResponse",
  "description": "Authenticated local research-terminal session; no broker or real-order authority",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "auth-session-v1" },
    "authenticated": { "const": true },
    "user": { "$ref": "#/definitions/AuthUser" },
    "csrfToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "absoluteExpiresAt": { "type": "string", "format": "date-time" },
    "idleExpiresAt": { "type": "string", "format": "date-time" }
  },
  "required": [
    "schemaVersion",
    "authenticated",
    "user",
    "csrfToken",
    "absoluteExpiresAt",
    "idleExpiresAt"
  ],
  "additionalProperties": false,
  "definitions": {
    "AuthUser": {
      "type": "object",
      "properties": {
        "userId": { "type": "string", "format": "uuid" },
        "username": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "const": "platform_admin" }
        }
      },
      "required": ["userId", "username", "displayName", "roles"],
      "additionalProperties": false
    }
  }
}
