{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kunlun-alpha/schemas/alerts/update-watchlist-alert-rule.json",
  "title": "UpdateWatchlistAlertRuleRequest",
  "description": "Append a name and decimal-threshold revision to an existing owned watchlist alert rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["clientRequestId", "expectedRevision", "name", "threshold"],
  "properties": {
    "clientRequestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "expectedRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "threshold": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$"
    }
  }
}
