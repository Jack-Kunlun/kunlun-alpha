{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kunlun-alpha/schemas/event/market-event.json",
  "title": "MarketEvent",
  "description": "Immutable, versioned market event with point-in-time evidence and model provenance",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "enum": ["market-event-v1"],
      "description": "Persistent MarketEvent contract version"
    },
    "eventId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Domain-derived SHA-256 identity over every immutable event fact"
    },
    "eventType": { "$ref": "#/definitions/MarketEventType" },
    "headline": { "type": "string", "minLength": 1, "maxLength": 500 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 5000 },
    "occurTime": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time; it may be in the future for announced plans"
    },
    "publishTime": { "type": "string", "format": "date-time" },
    "availableTime": {
      "type": "string",
      "format": "date-time",
      "description": "Earliest instant the validated event may enter downstream computation"
    },
    "instrumentIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9]{6}\\.(SH|SZ|BJ)$" },
      "uniqueItems": true
    },
    "sectorIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/EvidenceReference" }
    },
    "modelProvenance": { "$ref": "#/definitions/ModelProvenance" },
    "confidenceBps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000,
      "description": "Integer basis-point confidence; never a binary float"
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "headline",
    "summary",
    "occurTime",
    "publishTime",
    "availableTime",
    "instrumentIds",
    "sectorIds",
    "evidence",
    "modelProvenance",
    "confidenceBps"
  ],
  "additionalProperties": false,
  "definitions": {
    "MarketEventType": {
      "type": "string",
      "enum": [
        "CORPORATE",
        "EARNINGS",
        "FINANCING",
        "REGULATORY",
        "POLICY",
        "MACRO",
        "INDUSTRY",
        "MARKET",
        "RISK",
        "OTHER"
      ]
    },
    "ProducerType": {
      "type": "string",
      "enum": ["MODEL", "RULE"]
    },
    "EvidenceReference": {
      "type": "object",
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1 },
        "contentRecordId": { "type": "string", "minLength": 1 },
        "contentVersionId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sourceId": { "type": "string", "minLength": 1 },
        "sourceVersion": { "type": "string", "minLength": 1 },
        "availableTime": { "type": "string", "format": "date-time" },
        "startOffset": { "type": "integer", "minimum": 0 },
        "endOffset": { "type": "integer", "minimum": 1 },
        "excerpt": { "type": "string", "minLength": 1, "maxLength": 2000 }
      },
      "required": [
        "evidenceId",
        "contentRecordId",
        "contentVersionId",
        "sourceId",
        "sourceVersion",
        "availableTime",
        "startOffset",
        "endOffset",
        "excerpt"
      ],
      "additionalProperties": false
    },
    "ModelProvenance": {
      "type": "object",
      "properties": {
        "producerType": { "$ref": "#/definitions/ProducerType" },
        "provider": { "type": "string", "minLength": 1 },
        "modelId": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 },
        "promptVersion": { "type": "string", "minLength": 1 },
        "outputSchemaVersion": { "enum": ["market-event-v1"] },
        "configurationFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "extractionRunId": { "type": "string", "minLength": 1 },
        "processingTime": { "type": "string", "format": "date-time" }
      },
      "required": [
        "producerType",
        "provider",
        "modelId",
        "modelVersion",
        "promptVersion",
        "outputSchemaVersion",
        "configurationFingerprint",
        "extractionRunId",
        "processingTime"
      ],
      "additionalProperties": false
    }
  }
}
