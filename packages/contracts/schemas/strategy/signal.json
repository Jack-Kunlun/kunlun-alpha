{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kunlun-alpha.local/contracts/strategy/signal-v1.json",
  "title": "Signal",
  "description": "Versioned point-in-time research signal with no execution capability.",
  "type": "object",
  "additionalProperties": false,
  "x-python-strict-rfc3339": true,
  "required": [
    "schemaVersion",
    "signalId",
    "strategyId",
    "strategyVersion",
    "algorithmVersion",
    "entityId",
    "decisionTime",
    "dataCutoffTime",
    "direction",
    "score",
    "confidence",
    "horizonSessions",
    "rationale",
    "inputSnapshotId",
    "inputSnapshotVersion",
    "evidenceIds",
    "isExecutable",
    "executionCapability"
  ],
  "properties": {
    "schemaVersion": { "const": "signal-v1" },
    "signalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$"
    },
    "strategyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "strategyVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "algorithmVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "entityId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "decisionTime": { "type": "string", "format": "date-time" },
    "dataCutoffTime": { "type": "string", "format": "date-time" },
    "direction": { "enum": ["LONG", "SHORT", "NEUTRAL"] },
    "score": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "confidence": {
      "type": "string",
      "pattern": "^(?:0(?:\\.[0-9]+)?|1(?:\\.0+)?)$"
    },
    "horizonSessions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "x-python-strict": true
    },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "inputSnapshotId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "inputSnapshotVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "isExecutable": { "const": false },
    "executionCapability": { "const": "NONE" }
  }
}
