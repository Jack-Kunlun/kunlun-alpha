{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kunlun-alpha/schemas/emotion/limit-pool-snapshot.json",
  "title": "LimitPoolSnapshot",
  "description": "A point-in-time snapshot of the limit-up/limit-down pool",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Trading day in Asia/Shanghai"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Snapshot time, UTC ISO 8601"
    },
    "limitUpCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of limit-up instruments"
    },
    "limitDownCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of limit-down instruments"
    },
    "sealedCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of sealed (unopened) limit-up instruments"
    },
    "limitUpInstruments": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Limit-up unified codes"
    },
    "limitDownInstruments": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Limit-down unified codes"
    },
    "firstSealTime": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Earliest first-seal event time across the pool, UTC ISO 8601, or null when none sealed"
    },
    "lastSealTime": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Latest seal event time across the pool, UTC ISO 8601, or null when none sealed"
    },
    "totalOpenCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of seal openings (break-then-reseal) across the pool"
    }
  },
  "required": ["date", "timestamp", "limitUpCount", "limitDownCount", "sealedCount"],
  "additionalProperties": false
}
