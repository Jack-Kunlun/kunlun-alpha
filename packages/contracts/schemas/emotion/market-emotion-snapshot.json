{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kunlun-alpha/schemas/emotion/market-emotion-snapshot.json",
  "title": "MarketEmotionSnapshot",
  "description": "Versioned persisted market-emotion snapshot for real-time and historical replay",
  "type": "object",
  "properties": {
    "date": { "type": "string", "format": "date" },
    "timestamp": { "type": "string", "format": "date-time" },
    "score": { "type": "number" },
    "algorithmVersion": { "type": "string", "minLength": 1 },
    "ladder": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "board": { "type": "integer", "minimum": 1 },
          "count": { "type": "integer", "minimum": 0 }
        },
        "required": ["board", "count"],
        "additionalProperties": false
      }
    },
    "freshnessSeconds": { "type": "integer", "minimum": 0 },
    "sampleSize": { "type": "integer", "minimum": 0 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "sourceVersions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evidenceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "required": ["date", "timestamp", "score", "algorithmVersion", "ladder", "freshnessSeconds", "sampleSize", "confidence", "sourceVersions", "evidenceIds"],
  "additionalProperties": false
}
