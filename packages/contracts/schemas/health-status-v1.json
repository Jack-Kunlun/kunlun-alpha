{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kunlun-alpha/schemas/health-status-v1.json",
  "title": "HealthStatus",
  "description": "Service health-check response",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ok", "degraded", "error"],
      "description": "Current health status"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the check"
    },
    "version": {
      "type": "string",
      "description": "Service version string"
    }
  },
  "required": ["status", "timestamp", "version"],
  "additionalProperties": false
}
