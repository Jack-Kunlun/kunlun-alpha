{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kunlun-alpha/schemas/sector/sector-membership.json",
  "title": "SectorMembership",
  "description": "An instrument's membership in a sector, with a validity window and source",
  "type": "object",
  "properties": {
    "unifiedCode": {
      "type": "string",
      "pattern": "^\\d{6}\\.(SH|SZ|BJ)$",
      "description": "Instrument unified code"
    },
    "sectorId": {
      "type": "string",
      "description": "Sector id"
    },
    "validFrom": {
      "type": "string",
      "format": "date",
      "description": "Start of membership validity"
    },
    "validTo": {
      "type": ["string", "null"],
      "format": "date",
      "description": "End of membership validity, null means current"
    },
    "source": {
      "type": "string",
      "description": "Data source provenance"
    }
  },
  "required": ["unifiedCode", "sectorId", "validFrom", "source"],
  "additionalProperties": false
}
