{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BacktestRegressionArtifact",
  "$defs": {
    "SafeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": {
        "pattern": "\\.\\."
      }
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "CategoryCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "SCHEMA",
        "MANIFEST_INPUT",
        "ALGORITHM_CONFIG",
        "DEPENDENCY_TOOLCHAIN",
        "RESULT"
      ],
      "properties": {
        "SCHEMA": {
          "type": "integer",
          "minimum": 0
        },
        "MANIFEST_INPUT": {
          "type": "integer",
          "minimum": 0
        },
        "ALGORITHM_CONFIG": {
          "type": "integer",
          "minimum": 0
        },
        "DEPENDENCY_TOOLCHAIN": {
          "type": "integer",
          "minimum": 0
        },
        "RESULT": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ZeroCategoryCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "SCHEMA",
        "MANIFEST_INPUT",
        "ALGORITHM_CONFIG",
        "DEPENDENCY_TOOLCHAIN",
        "RESULT"
      ],
      "properties": {
        "SCHEMA": {
          "const": 0
        },
        "MANIFEST_INPUT": {
          "const": 0
        },
        "ALGORITHM_CONFIG": {
          "const": 0
        },
        "DEPENDENCY_TOOLCHAIN": {
          "const": 0
        },
        "RESULT": {
          "const": 0
        }
      }
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "Decimal": {
      "type": "string",
      "pattern": "^(?:0|-?(?:0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?))$"
    },
    "ContentDigestReference": {
      "title": "ContentDigestReference",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sha256"
      ],
      "properties": {
        "kind": {
          "const": "CONTENT_SHA256"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "OpaqueExternalDigestReference": {
      "title": "OpaqueExternalDigestReference",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "namespace",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "OPAQUE_EXTERNAL"
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "DigestReference": {
      "title": "DigestReference",
      "oneOf": [
        {
          "$ref": "#/$defs/ContentDigestReference"
        },
        {
          "$ref": "#/$defs/OpaqueExternalDigestReference"
        }
      ]
    },
    "RegressionTrust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "evidenceIntegrityConfidence",
        "evidenceRefs"
      ],
      "properties": {
        "mode": {
          "enum": [
            "FIXTURE_SELF_CONTAINED",
            "VERIFIED"
          ]
        },
        "evidenceIntegrityConfidence": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DigestReference"
          }
        }
      }
    },
    "RegressionManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "json",
        "sha256"
      ],
      "properties": {
        "json": {
          "type": "object"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "PortfolioHistoryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tapeId",
        "eventTapeDigest",
        "eventCount"
      ],
      "properties": {
        "tapeId": {
          "$ref": "#/$defs/SafeId"
        },
        "eventTapeDigest": {
          "$ref": "#/$defs/Sha256"
        },
        "eventCount": {
          "type": "integer",
          "minimum": 0,
          "x-python-strict": true
        }
      }
    },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationTime",
        "nav",
        "provenanceDigest"
      ],
      "properties": {
        "observationTime": {
          "$ref": "#/$defs/Timestamp"
        },
        "nav": {
          "$ref": "#/$defs/Decimal"
        },
        "provenanceDigest": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "RiskFreeObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationTime",
        "rate",
        "provenanceDigest"
      ],
      "properties": {
        "observationTime": {
          "$ref": "#/$defs/Timestamp"
        },
        "rate": {
          "$ref": "#/$defs/Decimal"
        },
        "provenanceDigest": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "ValuationLineageItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationTime",
        "inputDigest",
        "markDigest",
        "stateDigest",
        "nav"
      ],
      "properties": {
        "observationTime": {
          "$ref": "#/$defs/Timestamp"
        },
        "inputDigest": {
          "$ref": "#/$defs/Sha256"
        },
        "markDigest": {
          "$ref": "#/$defs/Sha256"
        },
        "stateDigest": {
          "$ref": "#/$defs/Sha256"
        },
        "nav": {
          "$ref": "#/$defs/Decimal"
        }
      }
    },
    "ValuationLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valuationPolicyId",
        "valuationPolicyVersion",
        "valuationPolicyDigest",
        "valuations"
      ],
      "properties": {
        "valuationPolicyId": {
          "type": "string",
          "minLength": 1
        },
        "valuationPolicyVersion": {
          "type": "string",
          "minLength": 1
        },
        "valuationPolicyDigest": {
          "$ref": "#/$defs/Sha256"
        },
        "valuations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ValuationLineageItem"
          }
        }
      }
    },
    "RegressionInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixtureSha256",
        "executionInputDigests",
        "portfolioHistoryRef",
        "valuationLineage",
        "navObservations",
        "riskFreeObservations",
        "tPlusOne"
      ],
      "properties": {
        "fixtureSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "executionInputDigests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Sha256"
          }
        },
        "portfolioHistoryRef": {
          "$ref": "#/$defs/PortfolioHistoryRef"
        },
        "valuationLineage": {
          "$ref": "#/$defs/ValuationLineage"
        },
        "navObservations": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/$defs/Observation"
          }
        },
        "riskFreeObservations": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/$defs/RiskFreeObservation"
          }
        },
        "tPlusOne": {
          "$ref": "#/$defs/TPlusOneInputs"
        }
      }
    },
    "DigestEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "CodeDigestEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "CodeProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowlist",
        "treeSha256"
      ],
      "properties": {
        "allowlist": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CodeDigestEntry"
          }
        },
        "treeSha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "ToolchainEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "uv",
        "evidenceSha256",
        "hatchling",
        "rootPyprojectSha256",
        "servicePyprojectSha256",
        "uvLockSha256"
      ],
      "properties": {
        "python": {
          "const": "3.12.13"
        },
        "uv": {
          "const": "0.12.3"
        },
        "evidenceSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "hatchling": {
          "type": "string",
          "minLength": 1
        },
        "rootPyprojectSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "servicePyprojectSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "uvLockSha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "RegressionProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "config",
        "dependencies",
        "toolchain"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/CodeProvenance"
        },
        "config": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DigestEntry"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DigestEntry"
          }
        },
        "toolchain": {
          "$ref": "#/$defs/ToolchainEvidence"
        }
      }
    },
    "RegressionVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "manifest",
        "eventOrder",
        "execution",
        "matching",
        "portfolio",
        "valuation",
        "metrics",
        "strategy",
        "policy",
        "fixture"
      ],
      "properties": {
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "eventOrder": {
          "type": "string",
          "minLength": 1
        },
        "execution": {
          "type": "string",
          "minLength": 1
        },
        "matching": {
          "type": "string",
          "minLength": 1
        },
        "portfolio": {
          "type": "string",
          "minLength": 1
        },
        "valuation": {
          "type": "string",
          "minLength": 1
        },
        "metrics": {
          "type": "string",
          "minLength": 1
        },
        "strategy": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "fixture": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "MetricValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "FinalValuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutoffTime",
        "nav",
        "totalPnl",
        "stateDigest",
        "inputDigest",
        "sampleCount"
      ],
      "properties": {
        "cutoffTime": {
          "$ref": "#/$defs/Timestamp"
        },
        "nav": {
          "$ref": "#/$defs/Decimal"
        },
        "totalPnl": {
          "$ref": "#/$defs/Decimal"
        },
        "stateDigest": {
          "$ref": "#/$defs/Sha256"
        },
        "inputDigest": {
          "$ref": "#/$defs/Sha256"
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 0,
          "x-python-strict": true
        }
      }
    },
    "RegressionResults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counts",
        "pnl",
        "finalNav",
        "finalValuation",
        "metrics",
        "observations",
        "tPlusOne"
      ],
      "properties": {
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "events": {
              "type": "integer",
              "minimum": 0
            },
            "intents": {
              "type": "integer",
              "minimum": 0
            },
            "orders": {
              "type": "integer",
              "minimum": 0
            },
            "fills": {
              "type": "integer",
              "minimum": 0
            },
            "navObservations": {
              "type": "integer",
              "minimum": 0
            },
            "tPlusOneRejected": {
              "type": "integer",
              "minimum": 0
            },
            "nextDaySellFills": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "events",
            "intents",
            "orders",
            "fills",
            "navObservations",
            "tPlusOneRejected",
            "nextDaySellFills"
          ]
        },
        "pnl": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "realized",
            "unrealized",
            "total",
            "fees"
          ],
          "properties": {
            "realized": {
              "$ref": "#/$defs/Decimal"
            },
            "unrealized": {
              "$ref": "#/$defs/Decimal"
            },
            "total": {
              "$ref": "#/$defs/Decimal"
            },
            "fees": {
              "$ref": "#/$defs/Decimal"
            }
          }
        },
        "finalNav": {
          "$ref": "#/$defs/Decimal"
        },
        "finalValuation": {
          "$ref": "#/$defs/FinalValuation"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cumulativeChainedReturn",
            "annualizedReturn",
            "annualizedVolatility",
            "maximumDrawdown",
            "sharpe",
            "sortino",
            "calmar"
          ],
          "properties": {
            "cumulativeChainedReturn": {
              "$ref": "#/$defs/MetricValue"
            },
            "annualizedReturn": {
              "$ref": "#/$defs/MetricValue"
            },
            "annualizedVolatility": {
              "$ref": "#/$defs/MetricValue"
            },
            "maximumDrawdown": {
              "$ref": "#/$defs/MetricValue"
            },
            "sharpe": {
              "$ref": "#/$defs/MetricValue"
            },
            "sortino": {
              "$ref": "#/$defs/MetricValue"
            },
            "calmar": {
              "$ref": "#/$defs/MetricValue"
            }
          }
        },
        "observations": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/$defs/Observation"
          }
        },
        "tPlusOne": {
          "$ref": "#/$defs/TPlusOneResults"
        }
      }
    },
    "BaselineApproval": {
      "title": "BaselineApproval",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalId",
        "reviewedBy",
        "reviewedAt",
        "reviewedArtifactSha256",
        "changeReference",
        "reason",
        "evidenceRefs"
      ],
      "properties": {
        "approvalId": {
          "$ref": "#/$defs/SafeId"
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 1
        },
        "reviewedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "reviewedArtifactSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "changeReference": {
          "$ref": "#/$defs/DigestReference"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DigestReference"
          }
        }
      }
    },
    "BacktestRegressionBaseline": {
      "title": "BacktestRegressionBaseline",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "baselineId",
        "suiteId",
        "expectedArtifact",
        "expectedArtifactSha256",
        "approval"
      ],
      "properties": {
        "schemaVersion": {
          "const": "backtest-regression-baseline-v1"
        },
        "baselineId": {
          "$ref": "#/$defs/SafeId"
        },
        "suiteId": {
          "$ref": "#/$defs/SafeId"
        },
        "expectedArtifact": {
          "$ref": "#"
        },
        "expectedArtifactSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "approval": {
          "$ref": "#/$defs/BaselineApproval"
        }
      }
    },
    "BacktestRegressionRunSummary": {
      "title": "BacktestRegressionRunSummary",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "suiteId",
        "runId",
        "fixtureId",
        "status",
        "candidateSha256",
        "baselineSha256",
        "dataStart",
        "dataEnd",
        "availability",
        "evidenceIntegrityConfidence",
        "preview"
      ],
      "properties": {
        "schemaVersion": {
          "const": "backtest-regression-summary-v1"
        },
        "suiteId": {
          "$ref": "#/$defs/SafeId"
        },
        "runId": {
          "$ref": "#/$defs/SafeId"
        },
        "fixtureId": {
          "$ref": "#/$defs/SafeId"
        },
        "status": {
          "enum": [
            "MATCHED",
            "DRIFTED"
          ]
        },
        "candidateSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "baselineSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "dataStart": {
          "$ref": "#/$defs/Timestamp"
        },
        "dataEnd": {
          "$ref": "#/$defs/Timestamp"
        },
        "availability": {
          "type": "string",
          "minLength": 1
        },
        "evidenceIntegrityConfidence": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "preview": {
          "type": "boolean",
          "x-python-strict": true
        }
      }
    },
    "BacktestRegressionDiff": {
      "title": "BacktestRegressionDiff",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "pointer",
        "status",
        "baselineValue",
        "candidateValue"
      ],
      "properties": {
        "category": {
          "enum": [
            "SCHEMA",
            "MANIFEST_INPUT",
            "ALGORITHM_CONFIG",
            "DEPENDENCY_TOOLCHAIN",
            "RESULT"
          ]
        },
        "pointer": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:/(?:[^~]|~[01])*)+$"
        },
        "status": {
          "enum": [
            "ADDED",
            "REMOVED",
            "REPLACED"
          ]
        },
        "baselineValue": {},
        "candidateValue": {}
      }
    },
    "BacktestRegressionComparison": {
      "title": "BacktestRegressionComparison",
      "type": "object",
      "additionalProperties": false,
      "x-python-semantic-validator": {
        "module": "ashare_contracts.backtest_regression_semantics",
        "function": "validate_backtest_regression_comparison"
      },
      "x-typescript-strip-semantic-branches": true,
      "required": [
        "baselineSha256",
        "candidateSha256",
        "status",
        "categoryCounts",
        "diffs",
        "diffLines"
      ],
      "properties": {
        "baselineSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "candidateSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "status": {
          "enum": [
            "MATCHED",
            "DRIFTED"
          ]
        },
        "categoryCounts": {
          "$ref": "#/$defs/CategoryCounts"
        },
        "diffs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BacktestRegressionDiff"
          }
        },
        "diffLines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "status": {
                  "const": "MATCHED"
                },
                "categoryCounts": {
                  "$ref": "#/$defs/ZeroCategoryCounts"
                },
                "diffs": {
                  "maxItems": 0
                },
                "diffLines": {
                  "maxItems": 0
                }
              }
            },
            {
              "properties": {
                "status": {
                  "const": "DRIFTED"
                },
                "diffs": {
                  "minItems": 1
                }
              }
            }
          ]
        }
      ]
    },
    "TPlusOneInputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "buyOrderId": {
          "$ref": "#/$defs/SafeId"
        },
        "sellOrderId": {
          "$ref": "#/$defs/SafeId"
        },
        "buyExecutionInputDigest": {
          "$ref": "#/$defs/Sha256"
        },
        "sameDaySellabilityDigest": {
          "$ref": "#/$defs/Sha256"
        },
        "nextDaySellabilityDigest": {
          "$ref": "#/$defs/Sha256"
        },
        "sameDayBatchDigest": {
          "$ref": "#/$defs/Sha256"
        },
        "nextDayBatchDigest": {
          "$ref": "#/$defs/Sha256"
        },
        "sameDaySellExecutionInputDigest": {
          "$ref": "#/$defs/Sha256"
        },
        "nextDaySellExecutionInputDigest": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "required": [
        "buyOrderId",
        "sellOrderId",
        "buyExecutionInputDigest",
        "sameDaySellabilityDigest",
        "nextDaySellabilityDigest",
        "sameDayBatchDigest",
        "nextDayBatchDigest",
