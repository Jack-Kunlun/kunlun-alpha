{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kunlun.local/contracts/data-quality/market-quality-evidence-v1.json",
  "title": "MarketQualityEvidencePage",
  "description": "A bounded, sanitized page of market-data rejection and filtering evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "publishedAt",
    "snapshotRecordCount",
    "matchingRecordCount",
    "offset",
    "limit",
    "hasMore",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "market-quality-evidence-v1"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "snapshotRecordCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "matchingRecordCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "hasMore": {
      "type": "boolean"
    },
    "records": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/MarketQualityEvidenceRecord"
      }
    }
  },
  "$defs": {
    "MarketQualitySource": {
      "title": "MarketQualitySource",
      "type": "string",
      "enum": ["tushare-pro", "akshare-tencent", "akshare-sina", "akshare-eastmoney"]
    },
    "MarketQualityInterval": {
      "title": "MarketQualityInterval",
      "type": "string",
      "enum": ["DAILY", "MINUTE_1", "MINUTE_5"]
    },
    "MarketQualityStatus": {
      "title": "MarketQualityStatus",
      "type": "string",
      "enum": ["REJECTED", "FILTERED"]
    },
    "MarketQualityReasonCode": {
      "title": "MarketQualityReasonCode",
      "type": "string",
      "enum": ["PROVIDER_PARSE_ERROR", "BAR_QUALITY_REJECTED", "SINA_OVERFETCH_OUTSIDE_REQUEST"]
    },
    "MarketQualityKind": {
      "title": "MarketQualityKind",
      "type": "string",
      "enum": ["OUT_OF_ORDER", "DUPLICATE", "NEGATIVE_PRICE", "ABNORMAL_VOLUME", "MISSING_FIELD"]
    },
    "MarketQualityFilteredReasonCode": {
      "title": "MarketQualityFilteredReasonCode",
      "type": "string",
      "const": "SINA_OVERFETCH_OUTSIDE_REQUEST"
    },
    "MarketQualityEvent": {
      "title": "MarketQualityEvent",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "unifiedCode", "timestamp"],
      "properties": {
        "kind": {
          "$ref": "#/$defs/MarketQualityKind"
        },
        "unifiedCode": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{6}\\.(SH|SZ|BJ)$"
        },
        "timestamp": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "MarketQualityFilteredRecord": {
      "title": "MarketQualityFilteredRecord",
      "type": "object",
      "additionalProperties": false,
      "required": ["rawRowIndex", "timestamp", "requestedStart", "requestedEnd", "reasonCode"],
      "properties": {
        "rawRowIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "requestedStart": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "requestedEnd": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "reasonCode": {
          "$ref": "#/$defs/MarketQualityFilteredReasonCode"
        }
      }
    },
    "MarketQualityEvidenceRecord": {
      "title": "MarketQualityEvidenceRecord",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "source",
        "unifiedCode",
        "interval",
        "requestedStart",
        "requestedEnd",
        "status",
        "reasonCode",
        "captureAvailableAt",
        "qualityRecordedAt",
        "rejectedRecordCount",
        "qualityEventCount",
        "filteredRecordCount",
        "qualityEvents",
        "filteredRecords"
      ],
      "properties": {
        "evidenceId": {
          "type": "string",
          "pattern": "^mqe-[0-9a-f]{64}$"
        },
        "source": {
          "$ref": "#/$defs/MarketQualitySource"
        },
        "unifiedCode": {
          "type": "string",
          "pattern": "^[0-9]{6}\\.(SH|SZ|BJ)$"
        },
        "interval": {
          "$ref": "#/$defs/MarketQualityInterval"
        },
        "requestedStart": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "requestedEnd": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "status": {
          "$ref": "#/$defs/MarketQualityStatus"
        },
        "reasonCode": {
          "$ref": "#/$defs/MarketQualityReasonCode"
        },
        "captureAvailableAt": {
          "type": "string",
          "format": "date-time"
        },
        "qualityRecordedAt": {
          "type": "string",
          "format": "date-time"
        },
        "rejectedRecordCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "qualityEventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "filteredRecordCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "qualityEvents": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/MarketQualityEvent"
          }
        },
        "filteredRecords": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/MarketQualityFilteredRecord"
          }
        }
      }
    },
    "MarketQualityEvidenceSnapshot": {
      "title": "MarketQualityEvidenceSnapshot",
      "description": "Immutable storage snapshot; its filename is the SHA-256 of canonical JSON bytes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "publishedAt", "records"],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "market-quality-snapshot-v1"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "records": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/MarketQualityEvidenceRecord"
          }
        }
      }
    },
    "MarketQualityEvidenceCurrent": {
      "title": "MarketQualityEvidenceCurrent",
      "description": "Atomic pointer to one complete immutable market-quality snapshot.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "snapshotId"],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "market-quality-current-v1"
        },
        "snapshotId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "MarketQualityEvidenceDetail": {
      "title": "MarketQualityEvidenceDetail",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "snapshotId", "publishedAt", "record"],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "market-quality-evidence-v1"
        },
        "snapshotId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "record": {
          "$ref": "#/$defs/MarketQualityEvidenceRecord"
        }
      }
    }
  }
}
