{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kunlun-alpha/schemas/market-data/tick.json",
  "title": "Tick",
  "description": "A single executed trade with millisecond-precision timestamp",
  "type": "object",
  "properties": {
    "unifiedCode": {
      "type": "string",
      "pattern": "^\\d{6}\\.(SH|SZ|BJ)$",
      "description": "Instrument unified code, e.g. 600000.SH"
    },
    "exchange": {
      "enum": ["SH", "SZ", "BJ"],
      "description": "Exchange code"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Trading day in Asia/Shanghai, e.g. 2026-08-13"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Trade time, UTC ISO 8601 with millisecond precision"
    },
    "price": { "type": "number", "minimum": 0, "description": "Trade price in CNY" },
    "volume": { "type": "integer", "minimum": 0, "description": "Trade volume in shares" },
    "amount": { "type": "number", "minimum": 0, "description": "Trade turnover in CNY" },
    "direction": {
      "enum": ["BUY", "SELL", "NEUTRAL"],
      "description": "Aggressor direction: BUY / SELL / NEUTRAL"
    },
    "tradeType": {
      "enum": ["MATCH", "AUCTION", "BLOCK"],
      "description": "MATCH / AUCTION / BLOCK"
    }
  },
  "required": [
    "unifiedCode",
    "exchange",
    "date",
    "timestamp",
    "price",
    "volume",
    "amount",
    "direction",
    "tradeType"
  ],
  "additionalProperties": false
}
