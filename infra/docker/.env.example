# P0-N11 本地数据基础设施 — 默认凭证（仅用于本地开发）

# IMPORTANT: These are LOCAL-ONLY default credentials.
# Never commit real credentials. Never use these values in production.

# PostgreSQL
POSTGRES_USER=kunlun
POSTGRES_PASSWORD=kunlun-local-dev
POSTGRES_DB=kunlun
# Local browser authentication. Keep insecure cookies limited to this exact loopback origin.
AUTH_PUBLIC_ORIGIN=http://localhost:5173
AUTH_ALLOW_INSECURE_COOKIE=true
# Claim-review local runtime example; never use a real credential here.
CLAIM_REVIEW_POSTGRES_DSN=postgresql://kunlun:kunlun-local-dev@localhost:5432/kunlun?options=-csearch_path%3Dkunlun%2Cpublic

# Redis
REDIS_PASSWORD=kunlun-local-dev

# ClickHouse
CLICKHOUSE_USER=kunlun
CLICKHOUSE_PASSWORD=kunlun-local-dev
CLICKHOUSE_DB=kunlun

# Real market Bars (AKShare default; optional Tushare switch; never commit a real token)
MARKET_DATA_PROVIDER=akshare
TUSHARE_TOKEN=
TUSHARE_API_URL=https://api.tushare.pro
INSTRUMENT_MASTER_RUNTIME_DSN=
INSTRUMENT_MASTER_RUNTIME_DSN_FILE=
INSTRUMENT_MASTER_MIGRATOR_DSN=
INSTRUMENT_MASTER_MIGRATOR_DSN_FILE=
INSTRUMENT_MASTER_MIGRATOR_PASSWORD=
INSTRUMENT_MASTER_RUNTIME_PASSWORD=
CALENDAR_QUALITY_RUNTIME_DSN=
CALENDAR_QUALITY_RUNTIME_DSN_FILE=
# Publish uses only this dedicated administrator DSN; *_FILE needs an explicit
# regular secret-file mount owned by UID 10001 with mode 0400.
CALENDAR_QUALITY_ADMIN_DSN=
CALENDAR_QUALITY_ADMIN_DSN_FILE=
CALENDAR_QUALITY_MIGRATOR_PASSWORD=
CALENDAR_QUALITY_RUNTIME_PASSWORD=
MARKET_DATA_SYMBOLS=600519.SH
MARKET_DATA_MINUTE_SYMBOLS=
MARKET_DATA_RUN_MODE=once
# Optional v1:auto:start schedule; HH:MM in Asia/Shanghai, daily bars only.
V1_MARKET_DATA_DAILY_AT=09:00
MARKET_DATA_POLL_SECONDS=60
MARKET_DATA_DAILY_LOOKBACK_DAYS=730
MARKET_DATA_MINUTE_INTERVAL=MINUTE_1
CLICKHOUSE_TIMEOUT_SECONDS=5
MARKET_DATA_RAW_VOLUME_NAME=kunlun-market-raw

# Optional managed instance-level provider settings. Leave every value empty
# to keep the existing environment-only worker mode. Master key and worker
# token must come from a deployment secret or an env file outside checkout;
# never fill them in this repository template or infra/docker/.env.
MARKET_DATA_SETTINGS_POSTGRES_DSN=
MARKET_DATA_SETTINGS_MASTER_KEY=
MARKET_DATA_SETTINGS_MASTER_KEY_FILE=
MARKET_DATA_SETTINGS_WORKER_TOKEN=
MARKET_DATA_SETTINGS_URL=
MARKET_DATA_SETTINGS_ALLOW_LOCAL_HTTP=false

# MinIO (S3-compatible)
MINIO_ROOT_USER=kunlun
MINIO_ROOT_PASSWORD=kunlun-local-dev
MINIO_DEFAULT_BUCKETS=kunlun-data

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=kunlun-local-dev

# Phase 0-3 application ports
SERVER_PORT=3002
WEB_PORT=5173
SAMPLE_ENGINE_PORT=8080
