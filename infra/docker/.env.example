# P0-N11 本地数据基础设施 — 默认凭证（仅用于本地开发）

# IMPORTANT: These are LOCAL-ONLY default credentials.
# Never commit real credentials. Never use these values in production.

# PostgreSQL
POSTGRES_USER=kunlun
POSTGRES_PASSWORD=kunlun-local-dev
POSTGRES_DB=kunlun

# Redis
REDIS_PASSWORD=kunlun-local-dev

# ClickHouse
CLICKHOUSE_USER=kunlun
CLICKHOUSE_PASSWORD=kunlun-local-dev
CLICKHOUSE_DB=kunlun

# MinIO (S3-compatible)
MINIO_ROOT_USER=kunlun
MINIO_ROOT_PASSWORD=kunlun-local-dev
MINIO_DEFAULT_BUCKETS=kunlun-data

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=kunlun-local-dev
