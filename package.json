{
  "name": "kunlun-alpha",
  "version": "0.0.0",
  "private": true,
  "description": "昆仑智策 - A-Share Intelligence & Quant Platform",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.21.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test && pnpm python:test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "node scripts/ci/prettier-check.mjs --write",
    "format:check": "node scripts/ci/prettier-check.mjs",
    "clean": "turbo clean",
    "check": "pnpm format:check && pnpm lint && pnpm python:lint && pnpm typecheck && pnpm python:typecheck && pnpm test",
    "python:sync": "uv sync",
    "python:lint": "uv run ruff check python/ services/",
    "python:format": "uv run ruff format python/ services/",
    "python:typecheck": "uv run basedpyright python/ services/",
    "python:test": "uv run pytest",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml --env-file infra/docker/.env up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml --env-file infra/docker/.env down",
    "infra:ps": "docker compose -f infra/docker/docker-compose.yml ps",
    "infra:logs": "docker compose -f infra/docker/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "turbo": "2.10.9",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "volta": {
    "node": "24.19.0",
    "pnpm": "11.21.0"
  }
}
